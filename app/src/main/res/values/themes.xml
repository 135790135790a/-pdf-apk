<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动窗口主题：决定 App 冷启动那一瞬间（Compose 还没画第一帧）的底色。

      为什么分三个：启动窗口是系统画的，那时读不到 Compose 状态。之前固定 @android:color/black，
      用户在 App 里选了「白天」，每次冷启动都会先闪一下黑。现在 MainActivity 在 super.onCreate
      之前按已保存的主题 setTheme 到 Day / Night 其中一个，闪屏颜色就和进来之后的画面一致了。

      默认 Theme.MangaShelf 保持深色（夜晚底色），给没有 setTheme 的公共路径兜底。
    -->
    <style name="Theme.MangaShelf" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 白天：暖白底 + 深色状态栏图标 -->
    <style name="Theme.MangaShelf.Day" parent="Theme.MangaShelf">
        <item name="android:windowBackground">@color/splash_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 夜晚：深灰底（#16161B，和 NightBackground 同色，不是纯黑） -->
    <style name="Theme.MangaShelf.Night" parent="Theme.MangaShelf">
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
